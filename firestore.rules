rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isErico() {
      return isSignedIn() && 
             request.auth.token.email == "ericocavalheiro.psico@gmail.com" && 
             request.auth.token.email_verified == true;
    }

    function verified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function tutored(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.isAuthorized == true;
    }
    function hasProfile() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function ownAuthor(data) {
      return data.authorId == request.auth.uid &&
        data.author == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name;
    }
    function validPhoto(data, field) {
      return !(field in data) || (data[field] is string && data[field].size() <= 260000 &&
        (data[field] == '' || data[field].matches('^data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+$')));
    }
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Blueprints ---

    function isValidUserProfile(data, userId) {
      return data.uid is string && data.uid == userId &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
             data.dogName is string && data.dogName.size() > 0 && data.dogName.size() <= 80 &&
             data.dogBreed is string && data.dogBreed.size() > 0 && data.dogBreed.size() <= 80 &&
             data.dogAge is string && data.dogAge.size() > 0 && data.dogAge.size() <= 40 &&
             data.focusArea is string && data.focusArea.size() <= 200 &&
             data.nextConsult is string && data.nextConsult.size() <= 200 &&
             data.consultProgress is number && data.consultProgress >= 0 && data.consultProgress <= 100 &&
             data.xpPoints is number && data.xpPoints >= 0 &&
             data.streakCount is number && data.streakCount >= 0 &&
             data.unlockedBadges is list && data.unlockedBadges.size() <= 50 &&
             data.isAuthorized is bool && validPhoto(data, 'dogPhoto') && validPhoto(data, 'dogAvatar');
    }

    function isValidTrainingLog(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId == userId &&
             data.date is string && data.date.size() <= 24 &&
             data.emotion is string && (data.emotion == 'focado' || data.emotion == 'calmo' || data.emotion == 'ansioso' || data.emotion == 'disperso') &&
             data.notes is string && data.notes.size() <= 5000;
    }

    function isValidForumPost(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.author is string && data.author.size() <= 120 &&
             data.dog is string && data.dog.size() <= 120 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 3000 &&
             data.likes is number && data.likes >= 0 &&
             data.likes <= 1000000;
    }

    function isValidChatMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.sender is string && (data.sender == 'erico' || data.sender == 'tutor') &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 4000;
    }

    function isValidDogQuestionnaire(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.step is number && data.step >= 1 && data.step <= 4 &&
             data.dogName is string && data.dogName.size() <= 120 &&
             data.dogAge is string && data.dogAge.size() <= 120 &&
             data.dogBreed is string && data.dogBreed.size() <= 120 &&
             data.primaryIssue is string && data.primaryIssue.size() <= 120 &&
             data.intensity is string && (data.intensity == 'leve' || data.intensity == 'moderada' || data.intensity == 'grave') &&
             data.additionalNotes is string && data.additionalNotes.size() <= 4096 &&
             data.submitted is bool;
    }

    function isValidEbookLead(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() > 5 && data.email.size() <= 254;
    }

    // --- Path Specific Matchers ---

    // 1. UsersProfiles (authorized)
    match /users/{userId} {
      allow get: if isOwner(userId) || isErico();
      // Allow searching or seeing profiles for social elements, but with zero PII exposure or list restrictions
      allow list: if isErico() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isOwner(userId) && 
                       isValidUserProfile(incoming(), userId) &&
                       incoming().keys().hasOnly(['uid', 'name', 'dogName', 'dogBreed', 'dogAge', 'focusArea', 'nextConsult', 'consultProgress', 'xpPoints', 'streakCount', 'unlockedBadges', 'isAuthorized', 'createdAt', 'updatedAt', 'dogPhoto', 'dogAvatar']) &&
                       (isErico() || incoming().isAuthorized == false) &&
                       incoming().createdAt == request.time;

      allow update: if (isOwner(userId) && 
                        isValidUserProfile(incoming(), userId) &&
                        incoming().uid == existing().uid &&
                        incoming().isAuthorized == existing().isAuthorized && // User cannot change authorization
                        incoming().createdAt == existing().createdAt &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'dogName', 'dogBreed', 'dogAge', 'dogPhoto', 'dogAvatar', 'updatedAt']) &&
                        incoming().updatedAt == request.time) ||
                       (isErico() && 
                        isValidUserProfile(incoming(), userId) &&
                        incoming().uid == existing().uid &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().updatedAt == request.time);
                        
      allow delete: if false; // Profiles are immortal to maintain consultation history
    }

    // 2. Sub-collection: TrainingLogs (Relational Sync)
    match /users/{userId}/logs/{logId} {
      allow read: if isOwner(userId) || isErico();
      
      allow create: if isOwner(userId) && 
                        isValidId(logId) &&
                        isValidTrainingLog(incoming(), userId) &&
                        incoming().createdAt == request.time;
                        
      allow update: if isOwner(userId) && 
                        isValidId(logId) &&
                        isValidTrainingLog(incoming(), userId) &&
                        incoming().createdAt == existing().createdAt &&
                        incoming().diff(existing()).affectedKeys().hasOnly(['emotion', 'notes', 'date']);
                        
      allow delete: if isOwner(userId) || isErico();
    }

    // Individual chat: tutor access is granted by the educator, never by the client.
    match /users/{userId}/messages/{messageId} {
      allow read: if isErico() || (verified() && isOwner(userId) && tutored(userId));
      allow create: if verified() && (isErico() || (isOwner(userId) && tutored(userId))) &&
        isValidId(messageId) && isValidChatMessage(incoming()) && incoming().id == messageId &&
        incoming().authorId == request.auth.uid && incoming().createdAt == request.time &&
        ((isErico() && incoming().sender == 'erico') || (!isErico() && incoming().sender == 'tutor'));
      allow update: if false;
      allow delete: if isErico();
    }

    // Appointments and summaries are written through the authenticated server API.
    match /users/{userId}/consultations/{consultationId} {
      allow read: if isOwner(userId) || isErico();
      allow write: if false;
    }

    // Only an explicitly selected avatar is shared; private profile fields stay private.
    match /tutor_public_profiles/{uid} {
      allow read: if verified();
      allow create, update: if isOwner(uid) &&
        incoming().keys().hasOnly(['uid', 'avatar', 'updatedAt']) && incoming().uid == uid &&
        incoming().avatar is string && incoming().avatar.size() <= 100000 &&
        (incoming().avatar == '' || incoming().avatar.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')) &&
        incoming().updatedAt == request.time;
      allow delete: if isOwner(uid) || isErico();
    }

    // Community available to all verified tutors.
    match /forum_posts/{postId} {
      allow read: if verified();
      allow create: if verified() && hasProfile() && isValidId(postId) &&
        incoming().keys().hasOnly(['id', 'authorId', 'author', 'dog', 'content', 'topic', 'likes', 'createdAt']) &&
        incoming().id == postId && ownAuthor(incoming()) && isValidForumPost(incoming()) &&
        incoming().dog == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.dogName &&
        incoming().topic in ['geral', 'passeios', 'sozinho', 'convivencia', 'latidos'] &&
        incoming().likes == 0 && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isErico() || (verified() && resource.data.authorId == request.auth.uid);
      match /comments/{commentId} {
        allow read: if verified();
        allow create: if verified() && hasProfile() &&
          exists(/databases/$(database)/documents/forum_posts/$(postId)) &&
          incoming().keys().hasOnly(['authorId', 'author', 'text', 'createdAt']) &&
          ownAuthor(incoming()) && incoming().text is string && incoming().text.size() > 0 &&
          incoming().text.size() <= 1500 && incoming().createdAt == request.time;
        allow update: if false;
        allow delete: if isErico() || (verified() && resource.data.authorId == request.auth.uid);
      }
      match /likes/{uid} {
        allow read: if verified();
        allow create: if verified() && isOwner(uid) &&
          exists(/databases/$(database)/documents/forum_posts/$(postId)) &&
          incoming().keys().hasOnly(['uid', 'createdAt']) && incoming().uid == uid && incoming().createdAt == request.time;
        allow delete: if isOwner(uid);
        allow update: if false;
      }
    }

    // Shared conversations: immutable messages, moderation by the educator.
    match /tutor_rooms/{roomId}/messages/{messageId} {
      allow read: if verified() && roomId in ['geral', 'passeios', 'sozinho', 'convivencia', 'latidos'];
      allow create: if verified() && hasProfile() && isValidId(messageId) &&
        roomId in ['geral', 'passeios', 'sozinho', 'convivencia', 'latidos'] &&
        incoming().keys().hasOnly(['id', 'authorId', 'author', 'text', 'createdAt']) &&
        incoming().id == messageId && ownAuthor(incoming()) &&
        incoming().text is string && incoming().text.size() > 0 && incoming().text.size() <= 4000 &&
        incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isErico();
    }
    match /_avatar_quotas/{quotaId} { allow read, write: if false; }

    // 5. Dog Questionnaire persistence (Diagnóstico de Vínculo Canino)
    match /dog_questionnaires/{questionnaireId} {
      allow get: if isValidId(questionnaireId);
      allow list: if isErico() || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isValidId(questionnaireId) && 
                       isValidDogQuestionnaire(incoming()) &&
                       incoming().id == questionnaireId &&
                       incoming().createdAt == request.time &&
                       incoming().updatedAt == request.time;

      allow update: if isValidId(questionnaireId) && 
                       isValidDogQuestionnaire(incoming()) &&
                       incoming().id == existing().id &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt == request.time;
                       
      allow delete: if isErico() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 6. Ebook Leads (Email capture)
    match /ebook_leads/{leadId} {
      allow create: if isValidId(leadId) && 
                       isValidEbookLead(incoming()) &&
                       incoming().id == leadId &&
                       incoming().createdAt == request.time;
      allow read, delete: if isErico();
    }
  }
}
