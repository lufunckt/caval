# Server-side only. Never prefix these with VITE_.
# A Firebase service account from the existing project, mounted as a secret file.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
GEMINI_API_KEY=
GEMINI_AVATAR_MODEL=gemini-3.1-flash-image
# Private video rooms and participant-specific expiring tokens (Daily).
DAILY_API_KEY=
PORT=3000
